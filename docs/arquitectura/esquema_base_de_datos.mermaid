%% Esquema de base de datos - Supabase (Postgres 17 + object storage)
%% Series particionadas por mes de inicio de sesion (ADR-044); identidad de borde (ADR-046).
%% Fuente del esquema: migraciones (ADR-045); snapshot para leer en src/db/schema.sql.
erDiagram
    PATIENTS ||--o{ SESSIONS : "tiene"
    PATIENTS ||--o{ PATIENT_ACCESS : "acceso"
    PATIENTS ||--o{ MODELS : "personaliza"
    PATIENTS ||--o{ FEEDBACK_CONFIG : "configura"
    SESSIONS ||--o{ RAW_BLOBS : "produce"
    SESSIONS ||--o{ STRIDES : "contiene"
    SESSIONS ||--o{ ANOMALY_SCORES : "produce"
    STRIDES ||--o{ GAIT_EVENTS : "IC MS TO"
    STRIDES ||--o{ FEATURE_VECTORS : "por pie o par bilateral"
    MODELS ||--o{ ANOMALY_SCORES : "produce"
    ANOMALY_SCORES ||--o{ ANOMALY_RAW_SNIPPETS : "dispara"
    DEVICES ||--o{ STRIDES : "detecta"
    DEVICES ||--o{ RAW_BLOBS : "captura"
    DEVICES ||--o{ MODEL_DEPLOYMENTS : "aloja"
    MODELS ||--o{ MODEL_DEPLOYMENTS : "se_despliega"
    MODELS ||--o{ RETRAIN_JOBS : "entra_sale"
    SESSIONS ||--o{ SESSION_MODELS : "provisiona"
    MODELS ||--o{ SESSION_MODELS : "corre_en"
    SESSIONS ||--o{ DEVICE_STATUS : "canal de estado"
    FEEDBACK_CONFIG ||--o{ SESSIONS : "usada_en"

    PATIENTS {
        uuid id PK
        text external_code
        int birth_year
        text cohort "healthy o affected (ADR-063)"
        text affected_side "left o right, solo si es affected"
        jsonb clinical_notes
    }
    PATIENT_ACCESS {
        uuid user_id PK
        uuid patient_id PK, FK
        text role "owner|clinician|patient"
    }
    DEVICES {
        uuid id PK
        text role "insole_left|insole_right|waist"
        text hw_uid "ID unico de la placa (ADR-059)"
        text hw_revision
        text firmware_version
    }
    SESSIONS {
        uuid id PK
        uuid patient_id FK
        text mode "exploratory|operational|edge"
        text feature_set_version
        boolean adaptation_enabled
        text reference_foot "pie de referencia del emparejado (ADR-063)"
        jsonb fsr_calibration "cero, carga de pie y umbrales de los FSR (ADR-062)"
        timestamptz started_at "se copia como session_started_at"
        timestamptz ended_at
        text end_reason "normal|link_lost|insole_lost|reboot|unclean"
        uuid continues_session_id FK "sesion anterior"
        bigint clock_t0_device "recta t_device a UTC (ADR-056)"
        timestamptz clock_t0_utc
        double clock_drift_ppm
        uuid feedback_config_id FK "config usada (ADR-059)"
    }
    RAW_BLOBS {
        uuid id PK
        uuid session_id FK
        uuid device_id FK
        text kind "samples|sync (ADR-061)"
        int chunk_index "tramo (ADR-055)"
        text storage_url "parquet"
        bigint n_samples
        text checksum
    }
    STRIDES {
        uuid session_id PK, FK
        text foot PK "left|right"
        int stride_seq PK "lo numera la plantilla"
        timestamptz session_started_at PK "particion mensual"
        uuid patient_id FK
        uuid device_id FK
        timestamptz started_at "IC que la abre"
        timestamptz ended_at "IC siguiente"
        text[] flags
    }
    GAIT_EVENTS {
        uuid session_id PK, FK
        text foot PK, FK
        int stride_seq PK, FK
        text type PK "IC|MS|TO"
        timestamptz session_started_at PK
        uuid patient_id FK
        timestamptz time
        bigint t_device "cuenta de la cintura (ADR-056)"
        real confidence
        text[] flags "no_crossover"
    }
    FEATURE_VECTORS {
        uuid session_id PK, FK
        text scope PK "left|right|bilateral"
        int unit_seq PK "stride_seq o cycle_seq"
        text features_source PK "device|offline"
        text feature_set_version PK
        timestamptz session_started_at PK
        uuid patient_id FK
        int left_stride_seq FK
        int right_stride_seq FK
        timestamptz time
        jsonb features
        text[] flags
    }
    ANOMALY_SCORES {
        uuid session_id PK, FK
        uuid model_id PK, FK
        text scope PK
        int unit_seq PK "la unidad del vector que lo disparo"
        timestamptz session_started_at PK
        uuid patient_id FK
        timestamptz time
        double score
        boolean is_anomaly
        double drift_metric
    }
    ANOMALY_RAW_SNIPPETS {
        uuid id PK
        uuid session_id FK
        uuid model_id FK
        text scope FK
        int unit_seq FK
        uuid device_id FK
        text storage_url
        timestamptz start_time
        timestamptz end_time
    }
    MODELS {
        uuid id PK
        uuid patient_id FK "null = global, sin scores"
        text algo
        text class "L|E|H|W"
        text inference_target "hub|host|worker"
        text retrain_target "micro|worker"
        text granularity "online|periodic|async"
        int version
        int parent_version
        text artifact_url
        text artifact_format "envelope_v1 (ADR-053)"
        text checksum "SHA-256 del sobre"
        jsonb metrics
        text status "una sola active por paciente y algo"
        uuid source_session_id FK "sesion que la produjo (ADR-059)"
    }
    SESSION_MODELS {
        uuid session_id PK, FK
        uuid model_id PK, FK
    }
    DEVICE_STATUS {
        uuid session_id PK, FK
        text device_role PK "insole_left|insole_right|waist"
        bigint t_device PK
        timestamptz session_started_at PK "particion mensual"
        uuid patient_id FK
        timestamptz time
        int battery_mv
        real imu_temp_c
        int uptime_s
        int packets_lost
        real sync_error_us
    }
    MODEL_DEPLOYMENTS {
        uuid id PK
        uuid model_id FK
        uuid device_id FK
        text status "active|rolled_back"
        timestamptz deployed_at
    }
    FIRMWARE_IMAGES {
        uuid id PK
        text version
        text target_role "insole|waist"
        text storage_url
        text checksum
    }
    RETRAIN_JOBS {
        uuid id PK
        text trigger "drift|schedule|manual"
        uuid model_in FK
        uuid model_out FK
        text status
        text worker
    }
    FEEDBACK_CONFIG {
        uuid id PK
        uuid patient_id FK
        text feedback_source "tipo de detector (ADR-059)"
        int window_strides
        double threshold_mild
        double threshold_marked
        double threshold_risk
    }
